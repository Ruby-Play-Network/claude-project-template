    "zod": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.0.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
